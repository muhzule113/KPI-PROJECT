# ============================================================
# KPI-PROJECT — Docker env template
# Copy ke .env lalu isi (WAJIB sebelum docker compose up)
# .env TIDAK boleh di-commit (sudah di .gitignore)
# ============================================================

# Generate secrets:
#   APP_KEY:            echo "base64:$(openssl rand -base64 32)"
#   DB_PASSWORD / ROOT: echo "$(openssl rand -base64 24)"
#   REVERB keys:        echo "$(openssl rand -hex 16)"

# Port aplikasi di host (Caddy reverse_proxy 127.0.0.1:<port>)
APP_PORT=8085
# Port Reverb di host (ws.kpi.muhzule.com -> 127.0.0.1:<port>)
REVERB_BIND_PORT=8080

# URL publik
APP_URL=https://kpi.muhzule.com

# Laravel
APP_KEY=base64:GANTI_PAKAI_OPENSSL_RAND

# Database
DB_PASSWORD=GANTI_PASSWORD_KUAT
MYSQL_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_KUAT

# Reverb (realtime websocket)
REVERB_APP_ID=kpi-app
REVERB_APP_KEY=GANTI_REVERB_KEY
REVERB_APP_SECRET=GANTI_REVERB_SECRET
REVERB_HOST=ws.kpi.muhzule.com
