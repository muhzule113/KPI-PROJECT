DATABASE_URL="postgresql://kpi:kpi@localhost:5433/kpi_management?schema=public"
POSTGRES_DB="kpi_management"
POSTGRES_USER="kpi"
POSTGRES_PASSWORD="kpi"
POSTGRES_PORT="5433"
# Opsional untuk pg_dump/pg_restore bila folder bin PostgreSQL tidak ada di PATH.
PG_BIN=""
# Opsional; default menyimpan dump ke web/backups.
BACKUP_DIR=""
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="ganti-dengan-secret-minimal-32-karakter"
SEED_ADMIN_NAME="Administrator KPI"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ganti-dengan-kata-sandi-kuat"
# Hanya diperlukan sekali saat menyalin database Laravel/MySQL lama.
# Gunakan akun MySQL read-only saat production.
LEGACY_DATABASE_URL="mysql://user_readonly:password@127.0.0.1:3306/kpi_management_db"
# Alternatif lokal bila backend lama masih ada: LEGACY_ENV_FILE="../backend/.env"
# Tanggal efektif versi KPI hasil migrasi tertunda, format YYYY-MM-DD (opsional).
MIGRATION_EFFECTIVE_DATE=""

# SMTP diperlukan untuk pemulihan kata sandi di production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="KPI OPS <no-reply@example.com>"

# Opsional. Default: Windows Defender pada Windows, `clamdscan` pada Linux/macOS.
# Upload evidence ditolak jika pemindai tidak tersedia atau hasilnya tidak bersih.
MALWARE_SCANNER_PATH=""
