{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx prisma/seed.ts",
    "db:migrate:legacy:dry": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx scripts/migrate-legacy.ts",
    "db:migrate:legacy": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx scripts/migrate-legacy.ts --apply",
    "db:verify:legacy": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx scripts/migrate-legacy.ts --verify-only",
    "db:backup": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx scripts/backup-postgres.ts",
    "db:restore:verify": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx scripts/verify-postgres-restore.ts",
    "jobs:run": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx scripts/run-maintenance.ts",
    "verify:import-worker": "node --import ./scripts/node-userinfo-workaround.mjs --import tsx scripts/verify-import-worker.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "fflate": "^0.8.3",
    "mysql2": "^3.24.4",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.24.4"
  }
}
