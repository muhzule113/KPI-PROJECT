  serviceCategory                  String             @default("general")
  serviceComplexity                String             @default("light")
  slaVersion                       String             @default("v1")
  slaBaselineDueAt                 DateTime?
  slaDueAt                         DateTime?
  slaBreachedAt                    DateTime?
  sparepartWaitMinutes             Int                @default(0)
  slaSnapshotJson                  Json?
  warrantyExpiresAt                DateTime?
  warrantyReviewStatus             String             @default("not_applicable")
  warrantyReviewReason             String?
  warrantyReviewedByUserId         String?
  warrantyReviewedAt               DateTime?
