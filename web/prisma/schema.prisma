  warrantyReturnedFromTicketId     String?
  customerConsentStatus            String             @default("pending")
  customerConsentAt                DateTime?
  customerConsentNotes             String?
  paymentStatus                    PaymentStatus      @default(UNPAID)
  paidAmount                       Decimal            @default(0) @db.Decimal(15, 2)
  paymentRecordedAt                DateTime?
  paymentExceptionType             String?
  paymentExceptionReason           String?
  paymentExceptionApprovedByUserId String?
  paymentExceptionApprovedAt       DateTime?
  deliveryRecipientType            String?
  deliveryRecipientName            String?
  deliveryNotes                    String?
  unrepairableReason               String?
  customerDeclinedReason           String?
  cancellationReason               String?
