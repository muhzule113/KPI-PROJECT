  updatedAt                        DateTime           @updatedAt
  branch                           Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  period                           KpiPeriod?         @relation(fields: [periodId], references: [id], onDelete: SetNull)
  intakeBy                         Employee?          @relation("TicketIntake", fields: [intakeByEmployeeId], references: [id], onDelete: SetNull)
  cashier                          Employee?          @relation("TicketCashier", fields: [cashierEmployeeId], references: [id], onDelete: SetNull)
  technician                       Employee?          @relation("TicketTechnician", fields: [technicianEmployeeId], references: [id], onDelete: SetNull)
  consentBy                        Employee?          @relation("TicketConsent", fields: [customerConsentByEmployeeId], references: [id], onDelete: SetNull)
  paymentRecordedBy                Employee?          @relation("TicketPayment", fields: [paymentRecordedByEmployeeId], references: [id], onDelete: SetNull)
  deliveredBy                      Employee?          @relation("TicketDelivery", fields: [deliveredByEmployeeId], references: [id], onDelete: SetNull)
  paymentExceptionApprovedBy       User?              @relation("PaymentExceptionApprover", fields: [paymentExceptionApprovedByUserId], references: [id], onDelete: SetNull)
  warrantyReviewedBy               User?              @relation("WarrantyReviewer", fields: [warrantyReviewedByUserId], references: [id], onDelete: SetNull)
  warrantyReturnedFrom             ServiceTicket?     @relation("WarrantyReturn", fields: [warrantyReturnedFromTicketId], references: [id], onDelete: SetNull)
